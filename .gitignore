# ------------------------------
# Python
# ------------------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# ------------------------------
# Secrets and local configuration
# ------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ------------------------------
# Local application data
# Keep the directory itself with data/.gitkeep if needed.
# ------------------------------
data/*
!data/.gitkeep
*.db
*.sqlite
*.sqlite3

# Logs and runtime files
*.log
logs/
*.pid

# ------------------------------
# Editors / IDEs
# ------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------
# Operating systems
# ------------------------------
.DS_Store
Thumbs.db

# Local archives and backups
*.zip
*.tar
*.tar.gz
*.bak


# Character sheets and other user uploads
storage/uploads/